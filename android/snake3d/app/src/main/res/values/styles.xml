<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RetroText">
        <item name="android:textColor">@color/neon</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">@color/neon</item>
        <item name="android:shadowDx">0.0</item>
        <item name="android:shadowDy">0.0</item>
        <item name="android:shadowRadius">14.0</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="Theme.Snake3D" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>
</resources>
